# Gateway Service
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
GATEWAY_READ_TIMEOUT=15s
GATEWAY_WRITE_TIMEOUT=15s

# JWT Configuration
JWT_SECRET=your-super-secret-key-min-32-chars-long
JWT_EXPIRATION=24h
JWT_ISSUER=currency-gateway

# Currency Service Connection
CURRENCY_SERVICE_URL=http://currency:8081
CURRENCY_SERVICE_TIMEOUT=10s

# Currency Service
CURRENCY_PORT=8081
CURRENCY_HOST=0.0.0.0

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=currency_user
DB_PASSWORD=currency_password
DB_NAME=currency_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Worker Configuration
WORKER_FETCH_INTERVAL=24h
WORKER_API_URL=https://latest.currency-api.pages.dev/v1/currencies/rub.json
WORKER_TARGET_CURRENCY=usd

# Logging
LOG_LEVEL=info
